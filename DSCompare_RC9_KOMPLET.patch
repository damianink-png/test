+"""Proof reuse must preserve results, placements and native error semantics."""
+from pathlib import Path
+import numpy as np
+import pytest
+from OCP.BRepPrimAPI import BRepPrimAPI_MakeBox
+from dsac29.geometry import describe
+from dsac29.alignment import _relocate
+from dsac29.native_guard import _load_brep, NativeGeometryFailure
+from dsac29.geometry_registry import GeometryRegistry
+from dsac29.registration_gate import frame_support, FrameProofCache
+from dsac29 import step_reexport_tolerance as step, native_guard
+
+
+def independent_parts():
+    return ([describe(BRepPrimAPI_MakeBox(10,12,14).Shape(),'A','A')],
+            [describe(BRepPrimAPI_MakeBox(10,12,14).Shape(),'B','B')])
+
+
+def force_proof(monkeypatch):
+    monkeypatch.setattr(GeometryRegistry,'same_definition',lambda *args:False)
+
+
+def test_sample_then_full_reuses_completed_proof(monkeypatch):
+    a,b=independent_parts();force_proof(monkeypatch);calls=[]
+    original=step.reexport_equivalent_world
+    def proof(*args,**kwargs):
+        calls.append(1);return original(*args,**kwargs)
+    monkeypatch.setattr(step,'reexport_equivalent_world',proof)
+    cache=FrameProofCache()
+    sample=frame_support(a,b,.01,proof_cache=cache)
+    full=frame_support(a,b,.01,verify_all=True,proof_cache=cache)
+    assert sample['proofs']==full['count']==1
+    assert full['pairs']==[(0,0)] and len(calls)==1 and cache.hits==1
+
+
+def test_reused_proof_is_bound_to_placement_and_tolerance():
+    a,b=independent_parts();cache=FrameProofCache()
+    frame_support(a,b,.01,proof_cache=cache)
+    with pytest.raises(ValueError):frame_support(a,b,.001,proof_cache=cache)
+    moved=[_relocate(b[0],np.eye(3),np.array([1.,0,0]))]
+    with pytest.raises(ValueError):frame_support(a,moved,.01,proof_cache=cache)
+    b[0].shape=moved[0].shape
+    with pytest.raises(ValueError):frame_support(a,b,.01,proof_cache=cache)
+
+
+def test_new_cache_does_not_reuse_another_hypothesis():
+    a,b=independent_parts();cache=FrameProofCache()
+    assert frame_support(a,b,.01,verify_all=True,proof_cache=cache)['count']==1
+    moved=[_relocate(b[0],np.eye(3),np.array([1.,0,0]))]
+    assert frame_support(a,moved,.01,verify_all=True,proof_cache=FrameProofCache())['count']==0
+
+
+def test_negative_proof_is_not_promoted_to_match(monkeypatch):
+    a,b=independent_parts();force_proof(monkeypatch)
