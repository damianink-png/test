+ def _sync(self,*args):
+  enabled=self.spin.isEnabled() and not self.spin.isReadOnly()
+  self.minus.setEnabled(enabled and self.spin.value()>self.spin.minimum())
+  self.plus.setEnabled(enabled and self.spin.value()<self.spin.maximum())
+ def eventFilter(self,obj,event):
+  if event.type() in (QEvent.EnabledChange,QEvent.ReadOnlyChange):self._sync()
+  return super().eventFilter(obj,event)
