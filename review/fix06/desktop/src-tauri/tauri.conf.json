{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DS Compare",
  "version": "0.5.0",
  "identifier": "pl.dscompare.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "features": [
      "desktop"
    ]
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DS Compare · Svelte 5 / Tauri 2",
        "width": 1440,
        "height": 960,
        "minWidth": 980,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; connect-src ipc: http://ipc.localhost; frame-src asset: http://asset.localhost; object-src 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "resources": [
      "engine/**/*"
    ],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "languages": [
          "Polish"
        ]
      }
    },
    "icon": [
      "../../assets/DSCompare.ico",
      "../../assets/DSCompare.png"
    ]
  }
}
